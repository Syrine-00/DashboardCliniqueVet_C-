<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <configSections>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!-- Base de données locale .mdf — pas besoin de SQL Server installé séparément -->
  <connectionStrings>
      <add name="CliniqueVet" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\CliniqueVet.mdf;Integrated Security=True;MultipleActiveResultSets=True;"
          providerName="System.Data.SqlClient" />
      <add name="CliniqueVet.Properties.Settings.CliniqueVetConnectionString"
          connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\CliniqueVet.mdf;Integrated Security=True"
          providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="MontantConsultation" value="30.00" />
    <add key="JoursRappelVaccin" value="30" />
  </appSettings>

</configuration>
